# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/flex

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Email (Brevo transactional email API)
EMAIL_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@flex.com

# Frontend origins allowed by Express and Socket.IO CORS (comma-separated)
CLIENT_URL=http://localhost:3000
CLIENT_URLS=https://flex.onrender.com
