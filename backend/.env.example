# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/flex

# JWT
# Must be a unique random value of at least 32 characters. The server refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
# Pick a currently available model from Google's models page: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Email (Brevo transactional email API)
EMAIL_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@flex.com

# Frontend origins allowed by Express and Socket.IO CORS (comma-separated)
CLIENT_URL=http://localhost:3000
CLIENT_URLS=https://flex.onrender.com
